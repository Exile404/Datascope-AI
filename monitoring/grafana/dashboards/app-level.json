      "targets": [{
        "expr": "(100 * sum(rate(http_requests_total{job=\"datascope-backend\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"datascope-backend\"}[5m])), 0.001)) or on() vector(0)",
