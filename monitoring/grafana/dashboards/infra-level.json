  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Host CPU usage",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "targets": [{
        "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}
        }
      },
      "options": {"colorMode": "background", "graphMode": "area"}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Host RAM used",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0},
      "targets": [{
        "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 75}, {"color": "red", "value": 90}]}
        }
      },
      "options": {"colorMode": "background", "graphMode": "area"}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Host disk used (root)",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 0},
      "targets": [{
        "expr": "100 * (1 - (node_filesystem_avail_bytes{mountpoint=\"/rootfs\",fstype=\"ext4\"} / node_filesystem_size_bytes{mountpoint=\"/rootfs\",fstype=\"ext4\"}))",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 75}, {"color": "red", "value": 90}]}
        }
      },
      "options": {"colorMode": "background", "graphMode": "area"}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Host load average (1m, 5m, 15m)",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "targets": [
        {"expr": "node_load1", "legendFormat": "1m", "refId": "A"},
        {"expr": "node_load5", "legendFormat": "5m", "refId": "B"},
        {"expr": "node_load15", "legendFormat": "15m", "refId": "C"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 0}
        }
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Host network I/O (RX + TX)",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [
        {"expr": "sum(rate(node_network_receive_bytes_total{device!~\"lo|veth.+|br-.+|docker.+\"}[1m]))", "legendFormat": "RX", "refId": "A"},
        {"expr": "sum(rate(node_network_transmit_bytes_total{device!~\"lo|veth.+|br-.+|docker.+\"}[1m]))", "legendFormat": "TX", "refId": "B"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      },
      "options": {"legend": {"displayMode": "table", "placement": "right"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Host memory breakdown",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "targets": [
        {"expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "legendFormat": "Used", "refId": "A"},
        {"expr": "node_memory_Buffers_bytes", "legendFormat": "Buffers", "refId": "B"},
        {"expr": "node_memory_Cached_bytes", "legendFormat": "Cached", "refId": "C"},
        {"expr": "node_memory_MemFree_bytes", "legendFormat": "Free", "refId": "D"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "stacking": {"mode": "normal"}}
        }
      },
      "options": {"legend": {"displayMode": "table", "placement": "right"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Disk I/O (read + write)",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "targets": [
        {"expr": "sum(rate(node_disk_read_bytes_total{device=~\"nvme.+|sd.+|dm-.+\"}[1m]))", "legendFormat": "Read", "refId": "A"},
        {"expr": "sum(rate(node_disk_written_bytes_total{device=~\"nvme.+|sd.+|dm-.+\"}[1m]))", "legendFormat": "Write", "refId": "B"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      },
      "options": {"legend": {"displayMode": "table", "placement": "right"}, "tooltip": {"mode": "multi"}}
    }
  ],
