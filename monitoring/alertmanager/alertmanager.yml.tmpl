# Alertmanager: routes Prometheus alerts to Gmail via SMTP.
# Secrets are injected via env vars from .env.monitor (gitignored).

global:
  resolve_timeout: 5m
  smtp_from: "$SMTP_FROM"
  smtp_smarthost: "smtp.gmail.com:587"
  smtp_auth_username: "$SMTP_USER"
  smtp_auth_password: "$SMTP_PASSWORD"
  smtp_require_tls: true

route:
  receiver: "gmail"
  group_by: ["alertname", "severity"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Critical alerts: page immediately, repeat every hour until resolved.
    - matchers:
        - severity = "critical"
      receiver: "gmail"
      group_wait: 10s
      repeat_interval: 1h

receivers:
  - name: "gmail"
    email_configs:
      - to: "$SMTP_TO"
        send_resolved: true
        headers:
          Subject: '[{{ .Status | toUpper }}{{ if eq .Status "firing" }}:{{ .Alerts.Firing | len }}{{ end }}] {{ .CommonLabels.alertname }} ({{ .CommonLabels.severity }})'
        html: |
          <h2>{{ .Status | toUpper }}: {{ .CommonLabels.alertname }}</h2>
          <p><b>Severity:</b> {{ .CommonLabels.severity }}</p>
          <p><b>Summary:</b> {{ .CommonAnnotations.summary }}</p>
          <p><b>Description:</b> {{ .CommonAnnotations.description }}</p>
          <hr>
          {{ range .Alerts }}
          <p><b>Started:</b> {{ .StartsAt }}<br>
          <b>Labels:</b><br>
          {{ range .Labels.SortedPairs }} &nbsp;&nbsp;{{ .Name }} = {{ .Value }}<br>{{ end }}
          </p>
          {{ end }}

inhibit_rules:
  # If a target is down, suppress higher-level alerts about its symptoms.
  - source_matchers:
      - alertname = "TargetDown"
    target_matchers:
      - severity =~ "warning|critical"
    equal: ["instance", "job"]
